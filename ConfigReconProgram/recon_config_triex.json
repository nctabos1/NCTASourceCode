        ],
        "description": "Replace values in a single column when the condition is met."
      },
      {
        "step": 3,
        "name": "Value Mapping Step Two",
        "filter": {
          "Roadway": "T33"
        },
        "conditions": [
          { "source": "RoadsideColumnA", "value": "RoadsideValueA" },
          { "source": "RoadsideColumnB", "value": "RoadsideValueB" }
        ],
        "description": "Replace values when both conditions (from two columns) are met."
      },
      {
        "step": 4,
        "name": "OCR Mapping",
        "filter": {
          "Roadway": "T33"
        },
        "description": "Apply OCR-related mappings to generate final OCR values.",
